# Home Assistant Configuration
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_token_here

# Google Home Mini Details
GOOGLE_HOME_IP=your_device_ip_here
GOOGLE_HOME_NAME=your_device_name
GOOGLE_HOME_MAC=your_mac_address_here
GOOGLE_HOME_DEVICE_ID=your_device_id

# MIDI Configuration
MIDI_OUTPUT_PORT=0
MIDI_CC_CHANNEL=1
MIDI_CC_NUMBER=74  # Default to filter cutoff

# Mapping Configuration
PROXIMITY_MIN=0
PROXIMITY_MAX=255
MIDI_VALUE_MIN=0
MIDI_VALUE_MAX=127

# Smoothing
ENABLE_SMOOTHING=true
SMOOTHING_FACTOR=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/inverse_theremin.log

# Web Server (optional)
ENABLE_WEB_SERVER=false
WEB_PORT=5000
